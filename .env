# App runtime
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
SECRET_KEY=change-me-now

# Ops persistence
OPS_DB_PATH=data/inids_ops.db

# Required API-key RBAC
INIDS_ADMIN_API_KEY=replace-admin-key
INIDS_SENSOR_API_KEY=replace-sensor-key
INIDS_VIEWER_API_KEY=replace-viewer-key

# API rate limiting
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_KEYS=10000

# Firewall adapter: mock | iptables | pf | ufw | nftables
FIREWALL_ADAPTER=mock
